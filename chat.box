```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart Campus Chatbot</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #eef4ff;
        }

        header {
            background: #2563eb;
            color: white;
            text-align: center;
            padding: 22px;
        }

        .chat-container {
            width: 90%;
            max-width: 600px;
            height: 600px;
            margin: 40px auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .chat-box {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
        }

        .message {
            padding: 12px 15px;
            margin: 10px 0;
            border-radius: 12px;
            max-width: 80%;
            line-height: 1.5;
        }

        .bot {
            background: #e5edff;
            color: #1e3a8a;
        }

        .user {
            background: #2563eb;
            color: white;
            margin-left: auto;
        }

        .input-area {
            display: flex;
            padding: 15px;
            border-top: 1px solid #ddd;
            gap: 10px;
        }

        #userInput {
            flex: 1;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
        }

        button {
            background: #2563eb;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }

        .back {
            display: block;
            width: fit-content;
            margin: 20px auto;
            text-decoration: none;
            color: #2563eb;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <header>
        <h1>🤖 Smart Campus Chatbot</h1>
        <p>Your Campus Assistant</p>
    </header>

    <div class="chat-container">

        <div class="chat-box" id="chatBox">

            <div class="message bot">
                👋 Hello! I am your Smart Campus Assistant.
                <br><br>
                You can ask me about notices, timetable, events, or classrooms.
            </div>

        </div>

        <div class="input-area">

            <input
                type="text"
                id="userInput"
                placeholder="Type your question..."
                onkeypress="handleEnter(event)"
            >

            <button onclick="sendMessage()">
                Send
            </button>

        </div>

    </div>

    <a href="index.html" class="back">
        ← Back to Home
    </a>

    <script>

        function sendMessage() {

            const input = document.getElementById("userInput");
            const message = input.value.trim();

            if (message === "") {
                return;
            }

            addMessage(message, "user");

            input.value = "";

            setTimeout(function () {

                const reply = getBotReply(message);

                addMessage(reply, "bot");

            }, 500);
        }


        function addMessage(text, type) {

            const chatBox = document.getElementById("chatBox");

            const messageDiv = document.createElement("div");

            messageDiv.className = "message " + type;

            messageDiv.innerHTML = text;

            chatBox.appendChild(messageDiv);

            chatBox.scrollTop = chatBox.scrollHeight;
        }


        function getBotReply(message) {

            message = message.toLowerCase();


            if (
                message.includes("hello") ||
                message.includes("hi") ||
                message.includes("hey")
            ) {

                return "👋 Hello! How can I help you with your campus information?";
            }


            if (
                message.includes("notice") ||
                message.includes("announcement")
            ) {

                return "📢 You can check the latest college announcements on the <b>College Notices</b> page.";
            }


            if (
                message.includes("timetable") ||
                message.includes("schedule") ||
                message.includes("class")
            ) {

                return "📅 You can check your daily class schedule on the <b>Timetable</b> page.";
            }


            if (
                message.includes("event") ||
                message.includes("program")
            ) {

                return "🎉 College events and programs are available on the <b>Events</b> page.";
            }


            if (
                message.includes("classroom") ||
                message.includes("location") ||
                message.includes("room")
            ) {

                return "📍 You can find classroom and campus location information on the <b>Classroom & Location</b> page.";
            }


            if (
                message.includes("thank")
            ) {

                return "😊 You're welcome! I'm always happy to help.";
            }


            if (
                message.includes("bye")
            ) {

                return "👋 Goodbye! Have a great day on campus!";
            }


            return "🤔 Sorry, I don't have that information yet. Try asking about <b>notices, timetable, events, or classrooms</b>.";
        }


        function handleEnter(event) {

            if (event.key === "Enter") {

                sendMessage();

            }

        }

    </script>

</body>

</html>
```
